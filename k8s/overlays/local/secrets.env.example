# Copy to secrets.env (git-ignored) and fill in. Becomes the forgeflow-secrets Secret.
# Generate the key with: uv run python -m forgeflow.scripts.generate_secret_key
FORGEFLOW_SECRET_KEY=
# LLM providers (optional while FAKE_LLM=true)
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_PLANNING=
NVIDIA_MODEL_CODING=
NVIDIA_MODEL_REVIEW=
OPENAI_API_KEY=
GROQ_API_KEY=
# Langfuse Cloud (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Jenkins outside the cluster (optional)
JENKINS_URL=
JENKINS_USER=
JENKINS_PASSWORD=
