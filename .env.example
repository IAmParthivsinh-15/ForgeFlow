# Copy to .env and fill in. Never commit .env.

FORGEFLOW_ENV=development
LOG_LEVEL=INFO

# --- Infrastructure (defaults target the docker compose ports on localhost) -------------
# Inside docker compose these are overridden to the service hostnames.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=forgeflow
# MongoDB Atlas: put your connection string here (used by the docker compose services) and,
# for processes run on the host, in MONGODB_URI as well, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Allow your IP in Atlas > Network Access. The free tier (M0) has 512 MB of storage.
MONGODB_URI_CONTAINERS=
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Repositories the Requirement Analyzer may inspect live under this directory
# (mounted read-only at /repos in docker compose).
REPOS_ROOT=./repos

# --- LLM ---------------------------------------------------------------------------------
# true = deterministic fake agents; no provider or API key needed.
FAKE_LLM=false

# Fallback order per profile is defined in config/models.yaml:
#   NVIDIA NIM -> OpenAI / LiteLLM -> Groq -> Ollama
# A provider is used only when both its key and its model id are set.

# NVIDIA NIM (primary). Pick model ids from https://build.nvidia.com/models
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=
NVIDIA_MODEL_PLANNING=
NVIDIA_MODEL_CODING=
NVIDIA_MODEL_REVIEW=

# OpenAI or an OpenAI-compatible LiteLLM proxy (set OPENAI_BASE_URL for LiteLLM).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_FAST=
OPENAI_MODEL_PLANNING=
OPENAI_MODEL_CODING=
OPENAI_MODEL_REVIEW=

# Groq
GROQ_API_KEY=
GROQ_MODEL_FAST=
GROQ_MODEL_PLANNING=
GROQ_MODEL_CODING=
GROQ_MODEL_REVIEW=

# Ollama (local). From inside docker use http://host.docker.internal:11434/v1
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Agents SDK tracing uploads traces to OpenAI (needs OPENAI_API_KEY). Off by default.
SDK_TRACING=false

# --- Requirement clarification -------------------------------------------------------------
MAX_CLARIFICATION_ROUNDS=3
MAX_QUESTIONS_PER_ROUND=3

# --- Development execution (Milestone 2) ----------------------------------------------------
# Task worktrees are created here (mounted at /workspaces in docker compose).
WORKSPACES_ROOT=./workspaces
MAX_PARALLEL_TASKS=3
AGENT_WORKER_CONCURRENCY=3
MAX_SUBTASKS=6
TASK_MAX_ATTEMPTS=2
TASK_RETRY_BACKOFF_SECONDS=10
TASK_TIMEOUT_SECONDS=1800
CHECK_TIMEOUT_SECONDS=600
GIT_AUTHOR_NAME=ForgeFlow
GIT_AUTHOR_EMAIL=forgeflow@localhost

# --- Verification (Milestone 3) -------------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2
OWASP_EDITION=2021
A2A_TIMEOUT_SECONDS=180
A2A_MAX_PER_RUN=3
# Local Jenkins started with `docker compose --profile ci up`. Change the password for
# anything beyond local development.
JENKINS_URL=http://localhost:8081
JENKINS_USER=forgeflow
JENKINS_PASSWORD=forgeflow-local
CI_TIMEOUT_SECONDS=1800

# --- Extensibility (connectors, MCP, skills) ------------------------------------------------
# Encrypts connector and MCP credentials. Generate: python -m forgeflow.scripts.generate_secret_key
# Keep it safe: losing it makes stored credentials unreadable (reconnect them).
FORGEFLOW_SECRET_KEY=
# How long an approval request (e.g. "open this pull request") waits for you.
APPROVAL_TIMEOUT_SECONDS=1800
GITHUB_API_URL=https://api.github.com
# Retention keeps a small database (e.g. Atlas free tier) from filling up.
EVENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# --- Knowledge: Elasticsearch / RAG (docker compose --profile search) ------------------------
# docker compose sets this to http://elasticsearch:9200 for the containers; for processes on
# the host use http://localhost:9200. Empty = search disabled. ForgeFlow keeps working (and
# reports search as unavailable) when Elasticsearch is not running.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_PREFIX=forgeflow
# Optional semantic search: any OpenAI-compatible /embeddings endpoint. Without these,
# search is keyword (BM25) only.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Observability (docker compose --profile observability) ----------------------------------
# Grafana http://localhost:3000 ; Prometheus http://localhost:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=forgeflow-local
# Langfuse Cloud (https://cloud.langfuse.com > project > Settings > API keys). Tracing is off
# unless both keys are set. Prompt/response text is only exported if TRACE_INCLUDE_CONTENT=true.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_INCLUDE_CONTENT=false

# --- Browser QA: Playwright MCP (docker compose --profile browser) ---------------------------
# Ports the app under test is served on inside the agent worker (one per concurrent QA run).
PREVIEW_PORTS=4173-4175
PREVIEW_START_TIMEOUT_SECONDS=60

# --- L4 autonomy (config/autonomy/contract.yaml) --------------------------------------------
# GitHub webhook secret (Settings > Webhooks > Secret). Without it the webhook refuses events;
# the scheduled sweep still finds eligible issues.
GITHUB_WEBHOOK_SECRET=
AUTONOMY_ENABLED=true
AUTONOMY_TICK_SECONDS=5
# Optional Slack-compatible webhook for alerts (escalations, emergency stops, breakers).
FORGEFLOW_ALERT_WEBHOOK_URL=
# Secrets: "local" (encrypted in MongoDB, development) or "vault" (HashiCorp Vault KV v2).
SECRET_BACKEND=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
VAULT_PREFIX=forgeflow
